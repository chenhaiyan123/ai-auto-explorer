{
  "name": "hiexplore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenhaiyan123/ai-auto-explorer.git"
  },
  "scripts": {
    "test:market": "npm run wake:build && node --test __test__/service-market.test.mjs",
    "test:budget": "npm run wake:build && node --test __test__/project-budget.test.mjs",
    "test:brief": "esbuild __test__/project-brief.test.tsx --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/project-brief.test.mjs && node node_modules/.cache/project-brief.test.mjs",
    "test:analytics": "node --test __test__/analytics.test.mjs",
    "test:loop": "esbuild __test__/exploration-loop.test.tsx --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/exploration-loop.test.mjs && node node_modules/.cache/exploration-loop.test.mjs",
    "test:billing": "npm run wake:build && node --test __test__/billing.test.mjs __test__/wechat-pay.test.mjs __test__/wallet-topup.test.mjs && esbuild __test__/billing-ui.test.tsx --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/hiexplore-billing-ui-test.mjs && node node_modules/.cache/hiexplore-billing-ui-test.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "test:inquiry": "esbuild __test__/inquiry.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hiexplore-inquiry-test.mjs && node node_modules/.cache/hiexplore-inquiry-test.mjs",
    "test:worktree": "esbuild __test__/worktree-ui.test.tsx --bundle --platform=node --format=cjs --outfile=node_modules/.cache/hiexplore-worktree-test.cjs && node node_modules/.cache/hiexplore-worktree-test.cjs",
    "test:agents": "esbuild __test__/agents.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hiexplore-agents-test.mjs && node node_modules/.cache/hiexplore-agents-test.mjs",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "app:dev": "VITE_DEV_SERVER_URL=http://localhost:3000 electron .",
    "app:dist": "npm run build && electron-builder",
    "explore": "node server/explorer-daemon.mjs",
    "auth": "node server/auth-server.mjs",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run ios:open",
    "mobile:apk": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "wake:build": "esbuild services/wakeRunner.ts --bundle --platform=node --format=esm --outfile=server/.wake-build/runner.mjs",
    "test:wake": "npm run wake:build && esbuild __test__/awakening.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hiexplore-wake-test.mjs && node node_modules/.cache/hiexplore-wake-test.mjs && node --test __test__/wake-server.test.mjs",
    "wake": "npm run wake:build && node server/wake-server.mjs",
    "test:shared": "npm run wake:build && node --test __test__/shared-models.test.mjs",
    "test:web": "npm run wake:build && node --test __test__/web-search.test.mjs",
    "test:heartbeat": "esbuild __test__/problem-heartbeat.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hiexplore-heartbeat-test.mjs && node node_modules/.cache/hiexplore-heartbeat-test.mjs",
    "test:life": "npm run wake:build && node --test __test__/wake-notifications.test.mjs && esbuild __test__/life-ui.test.tsx --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/hiexplore-life-ui-test.mjs && node node_modules/.cache/hiexplore-life-ui-test.mjs",
    "ios:prepare": "node scripts/build-ios.mjs",
    "ios:open": "npm run ios:prepare && npx cap open ios",
    "test:ios": "esbuild __test__/ios.test.tsx --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/hiexplore-ios-test.mjs && node node_modules/.cache/hiexplore-ios-test.mjs",
    "test:sync": "npm run wake:build && node --test __test__/project-sync.test.mjs && esbuild __test__/project-sync-client.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/project-sync-test.mjs && node node_modules/.cache/project-sync-test.mjs",
    "test:charter": "esbuild __test__/project-charter.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hiexplore-charter-test.mjs && node node_modules/.cache/hiexplore-charter-test.mjs",
    "test:wallet": "esbuild __test__/project-wallet.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hiexplore-wallet-test.mjs && node node_modules/.cache/hiexplore-wallet-test.mjs",
    "test:autonomy": "esbuild __test__/autonomy.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hiexplore-autonomy-test.mjs && node node_modules/.cache/hiexplore-autonomy-test.mjs",
    "test:router": "esbuild __test__/model-router.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hiexplore-router-test.mjs && node node_modules/.cache/hiexplore-router-test.mjs",
    "test:digest": "esbuild __test__/digest.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hiexplore-digest-test.mjs && node node_modules/.cache/hiexplore-digest-test.mjs",
    "test:metrics": "npm run wake:build && node --test __test__/metrics.test.mjs",
    "test:platform": "npm run wake:build && node --test __test__/platform-services.test.mjs",
    "test:profile": "esbuild __test__/pm-profile.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hiexplore-profile-test.mjs && node node_modules/.cache/hiexplore-profile-test.mjs",
    "test:pm": "npm run wake:build && esbuild services/pmAgent.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hiexplore-pm-agent.mjs && node --test __test__/pm-agent.test.mjs"
  },
  "build": {
    "appId": "com.hiexplore.app",
    "productName": "HiExplore",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chenhaiyan123",
        "repo": "ai-auto-explorer"
      }
    ]
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capacitor/toast": "^7.0.0",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/d3": "^7.4.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "description": "",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/chenhaiyan123/ai-auto-explorer/issues"
  },
  "homepage": "https://github.com/chenhaiyan123/ai-auto-explorer#readme"
}
