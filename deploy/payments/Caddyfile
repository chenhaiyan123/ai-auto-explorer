{
	admin off
}

{$PAYMENT_DOMAIN} {
	@projectSync path /projects/workspace
	request_body @projectSync {
		max_size 12MB
	}
	@otherRequests not path /projects/workspace
	request_body @otherRequests {
		max_size 300KB
	}
	# No access log, request body logging or application payload transformations.
	reverse_proxy backend:8790 {
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}
}
