# Copy to repository root .env.wake ON THE SERVER. Never commit the filled file.
# Generate once: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
# Back this value up separately from the volume; changing it loses access to saved model keys.
WAKE_MASTER_KEY=
# Must be the SAME trusted login backend used by the frontend's VITE_AUTH_API.
WAKE_AUTH_API=
WAKE_ALLOWED_ORIGINS=https://www.hiexplore.com
WAKE_GLOBAL_DAILY_CALLS=100
# Exact hostnames, operator-reviewed. Arbitrary private-network endpoints are not accepted.
WAKE_MODEL_HOSTS=api.openai.com,api.anthropic.com,api.deepseek.com,generativelanguage.googleapis.com,dashscope.aliyuncs.com,open.bigmodel.cn,ark.cn-beijing.volces.com,api.moonshot.cn,api.x.ai
WAKE_TEST_MODE=false
# Do not set WAKE_DEV_TOKEN on a public deployment.

# Exact identities verified by WAKE_AUTH_API /auth/me, normally full login emails.
# Frontend admin flags/passwords NEVER authorize shared model administration.
WAKE_ADMIN_IDENTITIES=
