# Copy to repository root .env.wake ON THE SERVER. Never commit the filled file.
# Generate once: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
# Back this value up separately from the volume; changing it loses access to saved model keys.
WAKE_MASTER_KEY=
# Must be the SAME trusted login backend used by the frontend's VITE_AUTH_API.
WAKE_AUTH_API=
WAKE_ALLOWED_ORIGINS=https://www.hiexplore.com
WAKE_GLOBAL_DAILY_CALLS=100
# Exact hostnames, operator-reviewed. Arbitrary private-network endpoints are not accepted.
WAKE_MODEL_HOSTS=api.openai.com,api.anthropic.com,api.deepseek.com,generativelanguage.googleapis.com,dashscope.aliyuncs.com,open.bigmodel.cn,ark.cn-beijing.volces.com,api.moonshot.cn,api.x.ai
WAKE_TEST_MODE=false
# Do not set WAKE_DEV_TOKEN on a public deployment.

# Exact identities verified by WAKE_AUTH_API /auth/me, normally full login emails.
# Frontend admin flags/passwords NEVER authorize shared model administration.
WAKE_ADMIN_IDENTITIES=
# 支付：默认关闭，商户签约、回调及真实小额验收完成后才开放。
# Pro 另有独立开关，套餐研究额度和项目限制接入前保持关闭。
BILLING_SALES_ENABLED=false
BILLING_PRO_ENABLED=false
# 小额验收时填写允许购买的已验证邮箱，以逗号分隔；留空表示不限制账号。
# 仅限制新下单，不影响已有订单到账、查询和已解锁成果下载；名单不返回前端。
BILLING_ALLOWED_IDENTITIES=
BILLING_PUBLIC_URL=
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
# 仅服务器读取的 PEM 文件路径；不要放在仓库、前端环境变量或聊天里。
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
# 微信 Native 支付（普通商户 / 平台证书模式）。证书及密钥仅挂载在服务端。
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_CERT_SERIAL=
WECHAT_CERT_FILE=
WECHAT_PRIVATE_KEY_FILE=
WECHAT_API_V3_KEY_FILE=
WECHAT_PLATFORM_CERT_FILE=
# 平台证书所在目录需允许服务用户写入，用于按需每 6 小时更新及轮换。

# Long-term research activation: 0 disables automatic starter credits.
# One claim per account, across all models. The pool caps lifetime starter grants.
WAKE_STARTER_TOKENS=0
WAKE_STARTER_POOL_TOKENS=0
# Optional important-event email, reusing the login service's Resend sender.
# Keep these SERVER-SIDE. Never use VITE_* for credentials.
RESEND_API_KEY=
MAIL_FROM=
WAKE_PUBLIC_URL=https://pay.hiexplore.com
WAKE_APP_URL=https://www.hiexplore.com
