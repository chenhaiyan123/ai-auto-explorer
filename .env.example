# ── 可选配置（全部留空也能运行：用户可在界面「⚙️ 设置」中配置本地/云端模型）──

# 默认云端 AI 代理地址（自部署的函数计算/Serverless，见 fc_backend.js）
# 配置后，新用户默认走该代理，无需自己填 API Key
VITE_API_PROXY_URL=

# 管理员看板密码（不设置则禁用管理员登录）
VITE_ADMIN_PASSWORD=

# 托管版登录后端地址（部署 server/auth-server.mjs 后填写，如 https://api.hiexplore.com）
# 不填 = 不启用真实登录，开源/本地版保持免登录（推荐开源版留空）
VITE_AUTH_API=

# 免配置体验代理地址（默认复用 VITE_AUTH_API，因为体验代理就在同一个 FC 后端）。
# 设置后：新/游客用户一进来就能用（DeepSeek，有额度），无需自己填 Key。
# 一般留空即可（自动用 VITE_AUTH_API）；只有体验后端和登录后端不在一起时才单独填。
VITE_TRIAL_API=
