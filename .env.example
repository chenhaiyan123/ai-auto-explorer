# ── 可选配置（全部留空也能运行：用户可在界面「⚙️ 设置」中配置本地/云端模型）──

# 默认云端 AI 代理地址（自部署的函数计算/Serverless，见 fc_backend.js）
# 配置后，新用户默认走该代理，无需自己填 API Key
VITE_API_PROXY_URL=

# 管理员看板密码（不设置则禁用管理员登录）
VITE_ADMIN_PASSWORD=

# 托管版登录后端地址（部署 server/auth-server.mjs 后填写，如 https://api.hiexplore.com）
# 不填 = 不启用真实登录，开源/本地版保持免登录（推荐开源版留空）
VITE_AUTH_API=
